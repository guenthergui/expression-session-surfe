{
  "$description": "EXPRESSION SESSION — design tokens. Fonte única: brand/tools/build_brand.py gera src/ui/tokens.css a partir deste arquivo. Não edite o CSS gerado.",
  "color": {
    "brand": {
      "underground-black": { "value": "#0A0A0A", "rgb": "10 10 10", "cmyk": "0 0 0 96", "use": "Fundo principal e identidade (60%)" },
      "rebel-red": { "value": "#E30613", "rgb": "227 6 19", "cmyk": "0 97 92 11", "use": "Destaques, ações e energia (10%)" },
      "pure-white": { "value": "#FFFFFF", "rgb": "255 255 255", "cmyk": "0 0 0 0", "use": "Textos, logotipo e contraste (25%)" },
      "concrete-gray": { "value": "#808080", "rgb": "128 128 128", "cmyk": "0 0 0 50", "use": "Informações secundárias (5%)" },
      "asphalt-gray": { "value": "#242424", "rgb": "36 36 36", "cmyk": "0 0 0 86", "use": "Painéis e superfícies" }
    },
    "support": {
      "signal-red": { "value": "#FF3B45", "use": "Vermelho para TEXTO pequeno sobre preto/asfalto (o Rebel Red fica abaixo de 4,5:1)" },
      "red-pressed": { "value": "#B0040F", "use": "Estado pressionado de ações vermelhas" },
      "red-hover": { "value": "#FF1A27", "use": "Hover de ações vermelhas" },
      "concrete-light": { "value": "#B3B3B3", "use": "Texto secundário sobre asfalto (contraste AA)" },
      "asphalt-raised": { "value": "#2E2E2E", "use": "Superfície em hover" },
      "asphalt-deep": { "value": "#161616", "use": "Superfície rebaixada, trilhos de barra" },
      "line": { "value": "rgba(255,255,255,0.10)", "use": "Divisórias" },
      "line-strong": { "value": "rgba(255,255,255,0.24)", "use": "Contornos de controles" }
    },
    "functional": {
      "$note": "Uso funcional apenas, nunca como cor de marca: avisos e estados que precisam ser lidos fora do vermelho.",
      "signal-amber": { "value": "#FFB020", "use": "Aviso (pouso instável, decolagem recusada)" },
      "positive": { "value": "#FFFFFF", "use": "Resultado positivo: branco + sinal/ícone (sem verde)" },
      "negative": { "value": "#FF3B45", "use": "Resultado negativo / queda" }
    }
  },
  "font": {
    "display": { "family": "Anton", "fallback": "Impact, 'Arial Narrow', sans-serif", "weights": [400], "use": "Títulos, campeonatos, publicidade" },
    "ui": { "family": "Barlow", "fallback": "'Segoe UI', system-ui, sans-serif", "weights": [400, 500, 600, 700], "use": "Menus, textos, diálogos e instruções" },
    "numeric": { "family": "Barlow Condensed", "fallback": "'Arial Narrow', sans-serif", "weights": [500, 600, 700, 800], "features": "tnum", "use": "Pontuação, cronômetros, multiplicadores, rótulos" }
  },
  "fontSize": {
    "hero": "clamp(48px, 7vw, 104px)",
    "h1": "clamp(30px, 3vw, 44px)",
    "h2": "24px",
    "item": "16px",
    "body": "15px",
    "small": "13px",
    "label": "12.5px",
    "score-xl": "clamp(56px, 7vw, 96px)",
    "score-l": "32px"
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px" },
  "radius": { "none": "0", "sm": "2px", "md": "3px", "pill": "999px" },
  "cut": { "sm": "8px", "md": "12px", "lg": "18px" },
  "shadow": {
    "panel": "0 18px 50px rgba(0,0,0,0.45)",
    "print": "3px 3px 0 #E30613",
    "lift": "0 10px 24px rgba(0,0,0,0.5)"
  },
  "motion": {
    "fast": "120ms",
    "base": "200ms",
    "slow": "420ms",
    "ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-punch": "cubic-bezier(0.3, 1.6, 0.4, 1)",
    "slant": "-11deg"
  },
  "z": { "hud": 5, "modal": 10, "toast": 20, "lab": 40, "loading": 50 }
}
